APP_ENV=development
LOG_LEVEL=INFO
HTTP_PORT=8080
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postcode
POSTGRES_USER=postcode
POSTGRES_PASSWORD=local-development-only
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Оставьте пустым для работы через обратный прокси (Vite / Nginx) без CORS и проблем с cookie
VITE_API_BASE_URL=
FRONTEND_PORT=5173
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
SERVER_DOMAIN=post-queue.duckdns.org
TZ=Europe/Moscow
# Alertmanager Telegram Notifications (Опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Подсистема уведомлений (демонстрационный адаптер и outbox worker)
NOTIFICATION_PROVIDER_URL=http://notification-demo:8082/notify
NOTIFICATION_TIMEOUT_SECONDS=2
NOTIFICATION_RETRY_INTERVAL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=3
# OAuth 2.0 Авторизация (Яндекс ID)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# SMS-шлюз (SMS Aero + резервный SMS.ru)
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=SMS Aero
SMSRU_API_KEY=
