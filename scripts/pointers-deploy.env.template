# /etc/pointers-deploy.env
# chmod 600 /etc/pointers-deploy.env
# NEVER commit this file to Git.

# ─── Docker Hub ───────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=vacuumxvx
DOCKERHUB_TOKEN=REPLACE_WITH_DOCKERHUB_PAT

# ─── Repo ─────────────────────────────────────────────────────────────────────
REPO_DIR=/root/tsifrovaya-ochered-novogo-pokoleniya

# ─── Branches ─────────────────────────────────────────────────────────────────
# WATCH_BRANCH: ветка с кодом разработчиков (merge requests → main)
WATCH_BRANCH=main
# GITOPS_BRANCH: ветка куда пишем Helm image tags (ArgoCD отслеживает её)
GITOPS_BRANCH=infra/k8s-gitops

# ─── Push URL для gitops ветки ────────────────────────────────────────────────
# Если gitops ветка не защищена — оставить пустым, будет использоваться origin
# Если нужен отдельный токен:
# GITOPS_PUSH_URL=https://oauth2:TOKEN@git.example.com/org/repo.git
GITOPS_PUSH_URL=

# ─── Dockerfiles & build contexts ────────────────────────────────────────────
FRONTEND_DOCKERFILE=frontend/Dockerfile.prod
FRONTEND_CONTEXT=frontend

BACKEND_DOCKERFILE=backend/Dockerfile
BACKEND_CONTEXT=backend

# ─── Helm ─────────────────────────────────────────────────────────────────────
VALUES_FILE=helm/queue-chart/values.yaml
