[Unit]
Description=Pointers GitOps Autodeploy — build & push changed Docker images, update Helm tags
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/tsifrovaya-ochered-novogo-pokoleniya
EnvironmentFile=/etc/pointers-deploy.env
ExecStart=/root/tsifrovaya-ochered-novogo-pokoleniya/scripts/gitops-autodeploy.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pointers-deploy
# Если скрипт упал — не считать таймер сломанным
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
